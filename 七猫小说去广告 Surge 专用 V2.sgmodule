#!name=七猫小说去广告 V2.1
#!desc=七猫小说去广告 V2.1：移除阅读页底部广告位及其轮换广告，并拦截开屏/章内/信息流/听书/悬浮窗广告。覆盖七猫全域响应体清理与汇川、广点通、穿山甲、快手、百度广告链路。
#!author=Codex
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png

[Script]
# ===== 七猫全域响应体去广告 =====
http-response ^https?:\/\/.*\.wtzw\.com\/.* requires-body=true,timeout=10,script-path=qimao_block.js,tag=七猫-wtzw全域
http-response ^https?:\/\/.*\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ requires-body=true,timeout=10,script-path=qimao_block.js,tag=七猫-头条广告
http-response ^https?:\/\/.*\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/.* requires-body=true,timeout=10,script-path=qimao_block.js,tag=七猫-穿山甲
http-response ^https?:\/\/.*\.snssdk\.com\/api\/ad\/union\/sdk\/.* requires-body=true,timeout=10,script-path=qimao_block.js,tag=七猫-snssdk广告

[Script Body (qimao_block.js)]
var body = $response.body;

function lower(v) {
  return v === null || v === undefined ? '' : String(v).toLowerCase();
}

function hasOwn(obj, key) {
  return Object.prototype.hasOwnProperty.call(obj, key);
}

function isAdSourceValue(v) {
  var s = lower(v);
  return s.indexOf('汇川') !== -1 ||
    s.indexOf('huichuan') !== -1 ||
    s.indexOf('广点通') !== -1 ||
    s.indexOf('穿山甲') !== -1 ||
    s.indexOf('头条') !== -1 ||
    s.indexOf('快手') !== -1 ||
    s.indexOf('百度') !== -1 ||
    s.indexOf('广告') !== -1 ||
    s.indexOf('推广') !== -1 ||
    s.indexOf('sponsor') !== -1 ||
    s.indexOf('sponsored') !== -1 ||
    s.indexOf('advert') !== -1 ||
    s.indexOf('admob') !== -1;
}

function isAdType(v) {
  var s = lower(v);
  return s === 'ad' || s === 'ads' || s === 'advert' || s === 'advertisement' || s === 'banner' ||
    s === 'promo' || s === 'promotion' || s === 'commercial' || s === 'sponsor' || s === 'sponsored' ||
    s === 'interstitial' || s === 'splash' || s === 'reward' || s === 'rewarded' || s === 'native' ||
    s === 'feed';
}

function isBadField(key, value) {
  var k = lower(key);
  if (!k) return false;
  if (k === 'ad' && value && value !== 0 && value !== '0' && value !== false) return true;
  if (k === 'ads' || k === 'ad_list' || k === 'adlist' || k === 'ad_info' || k === 'adinfo' ||
      k === 'ad_data' || k === 'addata' || k === 'ad_source' || k === 'adtype' || k === 'ad_type' ||
      k === 'ad_id' || k === 'adid' || k === 'ad_slot' || k === 'adslot' || k === 'ad_position' ||
      k === 'ad_position_id' || k === 'advertisement' || k === 'advertising' || k === 'advertiser' ||
      k === 'ad_banner' || k === 'banner_ad' || k === 'banner' || k === 'banner_list' ||
      k === 'bottom_banner' || k === 'bottom_banner_ad' || k === 'reader_ad' || k === 'reader_banner' ||
      k === 'reader_bottom_ad' || k === 'feed_ad' || k === 'splash_ad' || k === 'interstitial_ad' ||
      k === 'reward_ad' || k === 'native_ad' || k === 'bottom_ad' || k === 'creative' ||
      k === 'creative_list' || k === 'materials' || k === 'commercial' || k === 'promo' ||
      k === 'promotion' || k === 'sponsor' || k === 'sponsored') return true;
  if (/(^|[._-])(ad|ads|advert|advertisement|promo|promotion|commercial|sponsor|sponsored|native_ad|feed_ad|splash_ad|interstitial_ad|reward_ad|bottom_ad)([._-]|$)/.test(k)) return true;
  return false;
}

function looksLikeAdObject(obj) {
  if (!obj || typeof obj !== 'object') return false;
  if (obj.is_ad || obj.isAd || obj.isAds || obj.adFlag || obj.ad_flag || obj.has_ad || obj.hasAd) return true;
  for (var k in obj) {
    if (!hasOwn(obj, k)) continue;
    var v = obj[k];
    var lk = lower(k);
    if (lk === 'ad_id' || lk === 'adid' || lk === 'ad_slot' || lk === 'adslot' ||
        lk === 'ad_position_id' || lk === 'creative_id' || lk === 'advertiser_id') return true;
    if ((lk === 'source' || lk === 'provider' || lk === 'advertiser' || lk === 'vendor' ||
         lk === 'ad_source' || lk === 'ad_provider' || lk === 'ad_platform' || lk === 'ssp' || lk === 'dsp') &&
        isAdSourceValue(v)) return true;
    if ((lk === 'type' || lk === 'kind' || lk === 'category' || lk === 'view_type' || lk === 'card_type') &&
        isAdType(v)) return true;
  }
  return false;
}

function isEmptyObject(obj) {
  for (var k in obj) {
    if (hasOwn(obj, k)) return false;
  }
  return true;
}

function clean(node, parentKey) {
  if (node === null || node === undefined) return node;
  if (Array.isArray(node)) {
    var arr = [];
    for (var i = 0; i < node.length; i++) {
      var item = node[i];
      if (item && typeof item === 'object') {
        if (looksLikeAdObject(item)) continue;
        item = clean(item, parentKey);
        if (item && typeof item === 'object' && !Array.isArray(item) && isEmptyObject(item)) continue;
        if (Array.isArray(item) && item.length === 0) continue;
        arr.push(item);
      } else if (typeof item === 'string') {
        if (parentKey && isAdSourceValue(item) && (lower(parentKey).indexOf('source') !== -1 || lower(parentKey).indexOf('provider') !== -1 || lower(parentKey).indexOf('advertiser') !== -1 || lower(parentKey).indexOf('vendor') !== -1 || lower(parentKey).indexOf('platform') !== -1)) continue;
        arr.push(item);
      } else {
        arr.push(item);
      }
    }
    return arr;
  }
  if (typeof node === 'object') {
    var out = {};
    for (var key in node) {
      if (!hasOwn(node, key)) continue;
      var val = node[key];
      if (isBadField(key, val)) continue;
      if (val && typeof val === 'object' && looksLikeAdObject(val)) continue;
      out[key] = clean(val, key);
    }
    return out;
  }
  return node;
}

try {
  var obj = JSON.parse(body);
  obj = clean(obj, '');
  $done({body: JSON.stringify(obj)});
} catch (e) {
  $done({});
}

[Script Body (qimao_request.js)]
$done({});

