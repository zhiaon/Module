#!name=AI 中转站余额
#!desc=在 Surge 面板显示 AI 中转站 API Key 已用量和网站账户剩余余额。
#!author=Minis
#!category=zhiaon
#!system=ios
#!arguments=base_url:https://pipio.io,api_key:sk-xxxx,site_cookie:cookie,site_token:site-token,user_id:0,path:/api/usage/token/,site_path:/api/user/self,quota_per_usd:500000,currency:$,
#!arguments-desc=base_url: AI 中转站根地址，例如 https://pipio.io，不要以 / 结尾。\napi_key: API Key，用于查询已用量；pipio 填 sk- 开头的 API Key。\nsite_cookie: 网站登录 Cookie，用于查询账户剩余余额；填写后可不填 site_token 与 user_id。\nsite_token: 系统访问令牌；不使用 site_cookie 时，需配合数字 user_id。\nuser_id: pipio 数字用户 ID；仅 site_token 模式需要。\npath: API Key 用量接口；pipio 默认为 /api/usage/token/。\nsite_path: 网站账户余额接口；pipio 默认为 /api/user/self。\nquota_per_usd: 额度换算比例；pipio / One API / New API 常见为 500000。\ncurrency: 余额显示货币符号，例如 $ 或 ¥。

[Panel]
AI 中转站余额 = title=AI 中转站余额, content=加载中..., style=info, script-name=ai-relay-balance, update-interval=600

[Script]
ai-relay-balance = type=generic, script-path=https://raw.githubusercontent.com/zhiaon/Module/main/surge_scripts/ai-relay-balance.js, timeout=15, argument=baseURL={{{base_url}}}&apiKey={{{api_key}}}&siteCookie={{{site_cookie}}}&siteToken={{{site_token}}}&userId={{{user_id}}}&path={{{path}}}&sitePath={{{site_path}}}&quotaPerUSD={{{quota_per_usd}}}&currency={{{currency}}}
