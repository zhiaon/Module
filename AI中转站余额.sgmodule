#!name=AI 中转站余额
#!desc=在 Surge 面板显示 AI 中转站余额。填写 BaseURL 和 APIKey 即可，默认兼容 One API / New API。
#!author=Minis
#!category=zhiaon
#!system=ios
#!arguments=base_url:https://pipio.io,api_key:access_token,path:/api/user/self,quota_per_usd:500000,currency:$,
#!arguments-desc=base_url: AI 中转站根地址，例如 https://pipio.io，不要以 / 结尾。\napi_key: 账户 Access Token 或可访问余额接口的 Token；pipio 的 sk- API Key 通常不适用于 /api/user/self。\npath: 余额接口路径；One API / New API 通常为 /api/user/self。\nquota_per_usd: 额度换算比例；One API / New API 常见为 500000。\ncurrency: 余额显示货币符号，例如 $ 或 ¥。

[Panel]
AI 中转站余额 = title=AI 中转站余额, content=加载中..., style=info, script-name=ai-relay-balance, update-interval=600

[Script]
ai-relay-balance = type=generic, script-path=https://raw.githubusercontent.com/zhiaon/Module/main/surge_scripts/ai-relay-balance.js, timeout=15, argument=baseURL={{{base_url}}}&apiKey={{{api_key}}}&path={{{path}}}&quotaPerUSD={{{quota_per_usd}}}&currency={{{currency}}}
